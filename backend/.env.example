# ===== Simple RAG 后端环境变量示例 =====
# 复制为 backend/.env 后填写

# OpenAI 兼容协议 API Key（默认阿里云百炼 DashScope）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：切换任意 OpenAI 兼容服务（如 DeepSeek、OpenAI 官方代理等）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus
# OPENAI_EMBEDDING_MODEL=text-embedding-v4

# 服务配置
# APP_PORT=8000
# DEBUG=false
# LOG_LEVEL=INFO

# RAG 参数
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=4
